generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String    @id @default(cuid())
  name                 String?
  email                String    @unique
  emailVerified        DateTime?
  image                String?
  plan                 Plan      @default(FREE)
  stripeCustomerId     String?   @unique
  stripeSubscriptionId String?   @unique
  credits              Int       @default(3)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  briefs               Brief[]
  accounts             Account[]
  sessions             Session[]
}

model Brief {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  keyword     String
  language    String   @default("Français")
  tone        String   @default("Professionnel")
  intent      String   @default("Informationnel")
  wordCount   Int      @default(1500)
  competitors String?
  notes       String?
  output      String   @db.Text
  createdAt   DateTime @default(now())
}

enum Plan {
  FREE
  STARTER
  PRO
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Vehicle {
  id            String   @id
  brand         String
  model         String
  version       String?  @db.Text
  chemistry     String
  capacityKwh   Float?
  rangeWltpKm   Int
  rangeNote     String?  @db.Text
  trunkL        Int?
  trunkNote     String?  @db.Text
  priceFromEur  Int?
  priceNote     String?  @db.Text
  charge1080    String   @db.Text
  fastChargeMin Int?
  maxDcKw       Int?
  connector     String   @db.Text
  is800V        Boolean  @default(false)
  segment       String
  status        String   @default("neuf")
  officialUrl   String   @db.Text
  sources       String   @db.Text
  flags         Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
